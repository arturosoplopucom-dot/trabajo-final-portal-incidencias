{
  "name": "trabajo-final-portal-incidencias",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto base académico para automatizar incidencias con Playwright, Cucumber, Excel, Allure, PDF y Jenkins.",
  "scripts": {
    "bdd": "ts-node scripts/run-tests.ts --environment local",
    "bdd:local": "ts-node scripts/run-tests.ts --environment local",
    "bdd:jenkins": "ts-node scripts/run-tests.ts --environment jenkins",
    "features:prepare": "ts-node scripts/prepare-features.ts",
    "execution:prepare": "ts-node scripts/prepare-execution.ts",
    "clean": "ts-node scripts/clean-results.ts",
    "validate": "tsc --noEmit && ts-node scripts/validate-project.ts --environment local",
    "validate:jenkins": "tsc --noEmit && ts-node scripts/validate-project.ts --environment jenkins",
    "allure:generate": "allure generate allure/results --clean -o allure/report",
    "allure:open": "allure open allure/report",
    "allure:serve": "allure serve allure/results",
    "reporte": "npm run bdd && npm run allure:generate && npm run allure:open",
    "ci": "ts-node scripts/run-tests.ts --environment jenkins"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.0.0",
    "@cucumber/messages": "34.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.0.15",
    "@types/pdfkit": "^0.17.6",
    "allure-commandline": "2.43.0",
    "allure-cucumberjs": "3.10.2",
    "allure-js-commons": "3.10.2",
    "exceljs": "4.4.0",
    "pdfkit": "^0.19.1",
    "playwright": "1.61.1",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
